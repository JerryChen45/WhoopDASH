# Copy this file to .env and fill in your WHOOP app credentials
# (create an app at https://developer-dashboard.whoop.com)

WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URI registered in the WHOOP Developer Dashboard
REDIRECT_URI=http://localhost:8787/callback

# Server
PORT=8787

# How often to poll the WHOOP API (minutes)
POLL_MINUTES=15

# ---- Stress alert thresholds ----
# Recovery score below this % -> "low recovery" alert (once per day)
ALERT_RECOVERY_BELOW=33
# Day strain at/above this before ALERT_STRAIN_CUTOFF_HOUR -> "high strain early" alert
ALERT_STRAIN_ABOVE=15
ALERT_STRAIN_CUTOFF_HOUR=15
# Resting HR this fraction above your 14-day baseline -> alert (1.08 = +8%)
ALERT_RHR_FACTOR=1.08
# HRV this fraction below your 14-day baseline -> alert (0.75 = -25%)
ALERT_HRV_FACTOR=0.75

# ---- Workout nudges ----
# Comma-separated local times to check "have I worked out today?"
NUDGE_TIMES=16:00,19:00
# Only nudge if today's strain is still below this (i.e. you clearly haven't trained)
NUDGE_STRAIN_BELOW=10
# Rotating suggestions used in the nudge message
NUDGE_ACTIVITIES=run,tennis,gym

# No notifications between these hours (24h clock)
QUIET_START=22
QUIET_END=7
